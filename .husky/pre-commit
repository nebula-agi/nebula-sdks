#!/bin/sh
# Auto-bump SDK versions when code changes
# Only bumps version if current version is successfully published to PyPI/npm

# Never block commits. If version checks fail or can't be verified, skip bumps.
# Note: Husky typically runs hooks with `sh -e`, so we explicitly disable errexit.
set +e

# Check Python SDK
if git diff --cached --name-only | grep -q "^python/nebula/\|^python/tests/\|^python/pyproject.toml"; then
  echo "Python SDK changes detected, checking if current version is published..."
  if ! cd python; then
    echo "Could not enter python/ directory, skipping Python version bump"
  else

    # Run Ruff linter and formatter on staged files
    # Filter for Added, Copied, Modified files (exclude Deleted)
    STAGED_PYTHON_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep "^python/" | sed 's/^python\///')
    if [ -n "$STAGED_PYTHON_FILES" ]; then
      echo "Running Ruff on staged Python files..."
      if command -v ruff >/dev/null 2>&1; then
        RUFF_CMD="ruff"
      elif [ -f ".venv/bin/ruff" ]; then
        RUFF_CMD=".venv/bin/ruff"
      elif python3 -m ruff --version >/dev/null 2>&1; then
        RUFF_CMD="python3 -m ruff"
      else
        echo "Warning: Ruff not found (checked PATH, .venv/bin/ruff, and python3 -m ruff). Skipping linting."
        RUFF_CMD=""
      fi

      if [ -n "$RUFF_CMD" ]; then
        echo "$STAGED_PYTHON_FILES" | xargs $RUFF_CMD check --fix || exit 1
        echo "$STAGED_PYTHON_FILES" | xargs $RUFF_CMD format || exit 1
        echo "$STAGED_PYTHON_FILES" | xargs git add
      fi
    fi

  CURRENT_VERSION=$(python3 - << 'EOF'
import re
from pathlib import Path

text = Path("pyproject.toml").read_text()
in_project = False
for line in text.splitlines():
    if line.strip().startswith("["):
        in_project = line.strip() == "[project]"
    if in_project:
        match = re.match(r'\s*version\s*=\s*"([^"]+)"', line)
        if match:
            print(match.group(1))
            break
EOF
  )

  if [ -z "$CURRENT_VERSION" ]; then
    echo "Could not read current version from python/pyproject.toml, skipping Python version bump"
    cd ..
  else

  # Check if current version exists on PyPI
  echo "Checking if version $CURRENT_VERSION is published on PyPI..."
  PYPI_CHECK=$(CURRENT_VERSION="$CURRENT_VERSION" python3 - << 'EOF'
import sys
import urllib.request
import urllib.error
import os

version = os.environ.get('CURRENT_VERSION', '')
if not version:
    print("error")
    sys.exit(0)

try:
    url = f"https://pypi.org/pypi/nebula-client/{version}/json"
    with urllib.request.urlopen(url, timeout=5) as response:
        data = response.read()
        print("published")
        sys.exit(0)
except urllib.error.HTTPError as e:
    if e.code == 404:
        print("not_published")
        sys.exit(0)
    else:
        print("error")
        sys.exit(0)
except Exception:
    print("error")
    sys.exit(0)
EOF
 2>/dev/null)

  if [ "$PYPI_CHECK" != "published" ]; then
    if [ "$PYPI_CHECK" = "not_published" ]; then
      echo "Version $CURRENT_VERSION is not published on PyPI, skipping version bump"
    else
      echo "Could not verify if version $CURRENT_VERSION is published on PyPI, skipping version bump"
    fi
    cd ..
  else

    echo "✅ Version $CURRENT_VERSION is published on PyPI, proceeding with bump..."

    # Parse and bump patch version
    IFS='.' read -r major minor patch <<< "$CURRENT_VERSION"
    NEW_VERSION="${major}.${minor}.$((patch + 1))"

    echo "Bumping Python SDK: $CURRENT_VERSION -> $NEW_VERSION"

    python3 - << 'EOF' "$NEW_VERSION"
import re
import sys
from pathlib import Path

new_version = sys.argv[1]
path = Path("pyproject.toml")
text = path.read_text()
lines = text.splitlines()
in_project = False
updated = False

for i, line in enumerate(lines):
    if line.strip().startswith("["):
        in_project = line.strip() == "[project]"
    if in_project:
        match = re.match(r'\s*version\s*=\s*"([^"]+)"', line)
        if match:
            lines[i] = re.sub(r'"[^"]+"', f'"{new_version}"', line, count=1)
            updated = True
            break

if not updated:
    raise SystemExit("Could not find [project].version in pyproject.toml")

path.write_text("\n".join(lines) + ("\n" if text.endswith("\n") else ""))
EOF

    # Also update __init__.py if it exists
    if [ -f "nebula/__init__.py" ]; then
      python3 - << 'EOF' "$NEW_VERSION"
import re
import sys
from pathlib import Path

new_version = sys.argv[1]
path = Path("nebula/__init__.py")
text = path.read_text()
text = re.sub(r'__version__\s*=\s*"[^"]+"', f'__version__ = "{new_version}"', text)
path.write_text(text)
EOF
      git add nebula/__init__.py
    fi

    git add pyproject.toml
    cd ..
  fi
  fi
  fi
fi

# Check JavaScript SDK
if git diff --cached --name-only | grep -q "^javascript/src/"; then
  echo "JavaScript SDK changes detected, checking if current version is published..."
  if ! cd javascript; then
    echo "Could not enter javascript/ directory, skipping JavaScript version bump"
  else

  CURRENT_VERSION=$(node -p "require('./package.json').version" 2>/dev/null)
  if [ -z "$CURRENT_VERSION" ]; then
    echo "Could not read current version from javascript/package.json, skipping JavaScript version bump"
    cd ..
  else

  # Check if current version exists on npm
  echo "Checking if version $CURRENT_VERSION is published on npm..."
  if ! npm view "@nebula-ai/sdk@$CURRENT_VERSION" version >/dev/null 2>&1; then
    echo "Version $CURRENT_VERSION is not published on npm, skipping version bump"
    cd ..
  else
    echo "✅ Version $CURRENT_VERSION is published on npm, proceeding with bump..."

    # Parse and bump patch version
    IFS='.' read -r major minor patch <<< "$CURRENT_VERSION"
    NEW_VERSION="${major}.${minor}.$((patch + 1))"

    echo "Bumping JavaScript SDK: $CURRENT_VERSION -> $NEW_VERSION"

    # Update version
    npm version "$NEW_VERSION" --no-git-tag-version --allow-same-version

    git add package.json
    cd ..
  fi
  fi
  fi
fi

exit 0
